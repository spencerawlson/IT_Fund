# Copy to backend/.env for local dev (never commit the real file)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW=3600

# --- Character voices (Cyber Missions Phase 2, ElevenLabs) ---
# Spencer supplies the real key + voice IDs himself (portal -> server env
# file, never through chat). Without them the voice endpoint answers with a
# text-only fallback — nothing breaks. The key is backend-only; voice IDs
# never appear in frontend code or API responses.
# ELEVENLABS_API_KEY=
# CYPHER_VOICE_ID=
# SENTINEL_VOICE_ID=
# PATCH_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# VOICE_RATE_LIMIT=30
# VOICE_RATE_WINDOW=3600
# VOICE_CACHE_DIR=backend/.voice-cache
# VOICE_CACHE_MAX_MB=200

# --- Accounts / progress (C3) ---
# Production (self-hosted Postgres). Unset locally to use the bundled SQLite dev database.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/roadtocissp
# Browser origins allowed to call the API with credentials (comma-separated).
# APP_ORIGINS=http://localhost:5173,http://localhost:5188
# OAuth apps (C3.2): register with each provider and set the callback to /api/auth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
# APP_ORIGIN=http://localhost:5188   # base URL used to build OAuth callback + post-login redirect
# COOKIE_INSECURE=1                    # local http dev only; NEVER set in production
# ALLOW_DEV_LOGIN=1   # LOCAL ONLY: enables /api/auth/dev-login (owner test account) before OAuth is set up. Never set in production.

# --- Admin panel (Kay Ayiti model) ---
# Password-gated admin at /admin (Spencer only). No value here — set the
# real one in the host env vars (or backend/.env locally, never committed).
# ADMIN_PASSWORD=
