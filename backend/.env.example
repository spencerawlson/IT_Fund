# Copy to backend/.env for local dev (never commit the real file)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW=3600

# --- Accounts / progress (C3) ---
# Production (self-hosted Postgres). Unset locally to use the bundled SQLite dev database.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/roadtocissp
# Browser origins allowed to call the API with credentials (comma-separated).
# APP_ORIGINS=http://localhost:5173,http://localhost:5188
# OAuth apps (C3.2): register with each provider and set the callback to /api/auth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
# APP_ORIGIN=http://localhost:5188   # base URL used to build OAuth callback + post-login redirect
# COOKIE_INSECURE=1                    # local http dev only; NEVER set in production
# ALLOW_DEV_LOGIN=1   # LOCAL ONLY: enables /api/auth/dev-login (owner test account) before OAuth is set up. Never set in production.
