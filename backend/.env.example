# Copy to backend/.env for local dev (never commit the real file)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW=3600

# --- Character voices (Cyber Missions Phase 2, ElevenLabs) ---
# Spencer supplies the real key + voice IDs himself (portal -> server env
# file, never through chat). Without them the voice endpoint answers with a
# text-only fallback — nothing breaks. The key is backend-only; voice IDs
# never appear in frontend code or API responses.
# ELEVENLABS_API_KEY=
# CYPHER_VOICE_ID=
# SENTINEL_VOICE_ID=
# PATCH_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# VOICE_RATE_LIMIT=30
# VOICE_RATE_WINDOW=3600
# VOICE_CACHE_DIR=backend/.voice-cache
# VOICE_CACHE_MAX_MB=200
# Credits lesson read-aloud leaves untouched for mission briefings (0 = off)
# VOICE_LESSON_RESERVE_CREDITS=3000

# --- Accounts / progress (C3) ---
# Production (self-hosted Postgres). Unset locally to use the bundled SQLite dev database.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/roadtocissp
# Browser origins allowed to call the API with credentials (comma-separated).
# APP_ORIGINS=http://localhost:5173,http://localhost:5188
# OAuth apps (C3.2): register with each provider and set the callback to /api/auth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Sign in with Apple (Guideline 4.8, 2026-11-23): the Services ID is the OAuth
# client id; the .p8 key signs the short-lived client_secret JWT. All four are
# optional — while any one is unset, the Apple button is hidden, never broken.
# Full portal steps: docs/APPLE_SIGNIN.md.
# APPLE_CLIENT_ID=com.road2cissp.signin   # the Services ID (not the App ID)
# APPLE_TEAM_ID=                          # Apple Developer Team ID
# APPLE_KEY_ID=                           # Key ID of the .p8 key
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----   # .p8 contents; \n escapes are accepted
# SESSION_SECRET=
# APP_ORIGIN=http://localhost:5188   # base URL used to build OAuth callback + post-login redirect
# COOKIE_INSECURE=1                    # local http dev only; NEVER set in production
# ALLOW_DEV_LOGIN=1   # LOCAL ONLY: enables /api/auth/dev-login (owner test account) before OAuth is set up. Never set in production.

# --- Admin panel (/admin, Spencer only) ---
# Sign-in = a Google/GitHub account whose VERIFIED email is listed here, plus
# an authenticator-app code (set up on first visit). Defaults to
# BILLING_OWNER_EMAILS when unset. See docs/ADMIN.md. (ADMIN_PASSWORD is no
# longer used.)
# ADMIN_EMAILS=you@example.com
# Optional: separate key for encrypting authenticator secrets (defaults to
# SESSION_SECRET; changing either means setting the authenticator up again).
# ADMIN_MFA_KEY=

# --- Stripe billing ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...         # $29 USD/mo recurring price (live)
# STRIPE_PRICE_ID_ANNUAL=price_...  # $250 USD/yr recurring price — create in
# the Stripe dashboard (Products > Add price: $250 USD, recurring yearly),
# then paste the price_... id here and restart the backend. Until it is set,
# /pricing shows annual as coming soon and annual checkout returns 503.
# BILLING_APP_URL=https://www.road2cissp.com

# --- In-app purchases (Guideline 3.1.1, StoreKit 2 direct, 2026-11-23) ---
# No secret is needed to verify App Store transactions: the signed JWS is
# checked against the bundled Apple Root CA - G3 (backend/iap.py). The only
# settings are the bundle ID (default com.road2cissp.app) and, once the App
# Store Connect app record exists, its numeric app ID — when set, server
# notifications must carry the same appAppleId. Full portal steps:
# docs/IAP.md. Products are created in App Store Connect, not here.
# IAP_BUNDLE_ID=com.road2cissp.app
# APPLE_APP_ID=
