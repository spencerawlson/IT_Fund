# IT_Fund backend — systemd user unit
# Install: cp deploy/itfund-backend.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now itfund-backend
# Requires: repo cloned at ~/IT_Fund, venv at ~/IT_Fund/backend/.venv,
#           env file at ~/.config/itfund/backend.env (chmod 600), linger enabled.

[Unit]
Description=IT_Fund FastAPI backend (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/IT_Fund/backend
EnvironmentFile=%h/.config/itfund/backend.env
# Enable real container labs (hardened DockerLabProvider). This overrides the
# env file, so labs go live on the next `systemctl --user restart` without
# editing backend.env. It still requires a reachable Docker daemon AND the
# images built (backend/labs/images/build.sh); until then, provider="docker"
# labs report "unavailable" — mock labs are unaffected.
Environment=LAB_DOCKER_ENABLED=1
# Single worker (L-03 interim): lab sessions, findings and rate limiters live in
# per-process memory, so a session created on worker A 404s on worker B under
# --workers 2. Run one worker until the DB-backed session store lands (roadmap);
# throughput trade-off: the backend is single-process, so one slow request can
# briefly delay others — acceptable for this traffic level, and far better than
# intermittent 404s on live labs.
ExecStart=%h/IT_Fund/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=5
# Hardening: backend only needs localhost networking, its own tree, and /tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/IT_Fund/backend %h/.config/itfund
PrivateTmp=true

[Install]
WantedBy=default.target
