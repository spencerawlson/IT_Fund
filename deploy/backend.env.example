# =============================================================================
# IT_Fund backend environment — EXAMPLE ONLY. NEVER COMMIT THE REAL FILE.
# Copy to ~/.config/itfund/backend.env on the server, fill in real values,
# then: chmod 600 ~/.config/itfund/backend.env
# =============================================================================

# Marks this as a production deployment: enables strict startup checks
# (SESSION_SECRET and DATABASE_URL become required) and runs Alembic
# migrations automatically at startup.
APP_ENV=production

# Public hostname of the backend (no trailing slash). Used for OAuth
# redirect URIs: {APP_ORIGIN}/api/auth/{provider}/callback
APP_ORIGIN=https://api.road2cissp.com
# Where the browser lands after OAuth (login success or error). The API and the
# app live on different origins in production, so this is separate from APP_ORIGIN.
FRONTEND_URL=https://www.road2cissp.com

# Browser origins allowed to call the API (CORS), comma-separated.
# Must include the Vercel frontend domain.
APP_ORIGINS=https://road2cissp.com,https://www.road2cissp.com

# Session signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=PASTE_64_HEX_CHARS_HERE

# Postgres connection. Create the database and user first (see deploy/README.md).
DATABASE_URL=postgresql://itfund:PASSWORD@localhost:5432/itfund

# OpenAI key — powers the AI tutor. Required for tutor responses.
OPENAI_API_KEY=sk-...

# --- Optional: social login ------------------------------------------------
# Register each callback URL in the provider console:
#   {APP_ORIGIN}/api/auth/google/callback
#   {APP_ORIGIN}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Interactive labs: real container execution -------------------------------
# Default 0 = every lab simulates (mock provider). Set to 1 on a host with a
# reachable Docker daemon to enable the hardened DockerLabProvider, then build
# the images (backend/labs/images/build.sh) and restart the backend.
# Labs whose definition names provider="docker" (first: py-basics-001) fail
# with "unavailable" while this is 0 — there is no silent fallback.
LAB_DOCKER_ENABLED=0

# --- Stripe subscription billing ($19/mo) ------------------------------------
# Leave all three empty to run without billing (endpoints return 503, app works).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Where Stripe sends users after checkout/cancel (no trailing slash).
BILLING_APP_URL=https://www.road2cissp.com

# --- NEVER set these in production ------------------------------------------
# ALLOW_DEV_LOGIN=1   (dev-only backdoor — never enable in production)
