{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        { "source": "/", "destination": "/index.html" },
        { "source": "/app", "destination": "/index.html" },
        { "source": "/academy", "destination": "/index.html" },
        { "source": "/academy/:path*", "destination": "/index.html" },
        { "source": "/signin", "destination": "/index.html" },
        { "source": "/practice", "destination": "/index.html" },
        { "source": "/library", "destination": "/index.html" },
        { "source": "/module/:path*", "destination": "/index.html" },
        { "source": "/lab", "destination": "/index.html" },
        { "source": "/admin", "destination": "/index.html" },
        { "source": "/tracks", "destination": "/index.html" },
        { "source": "/roadmap", "destination": "/index.html" },
        { "source": "/challenge", "destination": "/index.html" },
        { "source": "/learning-path", "destination": "/index.html" },
        { "source": "/registry", "destination": "/index.html" },
        { "source": "/pricing", "destination": "/index.html" },
        { "source": "/privacy", "destination": "/index.html" },
        { "source": "/terms", "destination": "/index.html" },
        { "source": "/contact", "destination": "/index.html" },
        { "source": "/faq", "destination": "/index.html" },
        { "source": "/labs", "destination": "/index.html" },
        { "source": "/labs/:path*", "destination": "/index.html" },
        { "source": "/missions/:path*", "destination": "/index.html" },
        { "source": "/design", "destination": "/index.html" }
      ]
    }
  }
}
