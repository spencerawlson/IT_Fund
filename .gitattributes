# Road to CISSP is built and deployed on Linux; keep every text file LF regardless of the
# developer's OS. Without this, a Windows checkout rewrites LF->CRLF and (a) the Docker lab seed
# fixtures stop being byte-identical to the mock shells (their integrity tests fail), and (b) shell
# scripts like the git hook below break on Linux. See backend/labs/images/README.md.
* text=auto eol=lf

# Shell scripts and the git hook MUST stay LF or they won't run on Linux / in CI.
*.sh          text eol=lf
.githooks/*   text eol=lf

# Binary assets: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.evtx  binary
*.pyc   binary
